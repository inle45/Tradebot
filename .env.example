# Copie ce fichier en ".env" et remplis tes vraies valeurs. Ne commite jamais le .env.

# Chemin vers ta clé privée Ed25519 (generee avec openssl genpkey -algorithm ed25519 -out private.pem)
REVX_PRIVATE_KEY_PATH=./private.pem

# Clé API obtenue sur l'app Revolut X après avoir uploadé ta clé publique
REVX_API_KEY=

# Paire à trader (ex: SOL-EUR)
TRADEBOT_SYMBOL=SOL-EUR

# Plafond max en EUR que le bot peut engager en mode réel
TRADEBOT_MAX_POSITION_EUR=100

# Paramètres de la stratégie moyennes mobiles (en nombre de bougies)
TRADEBOT_SMA_SHORT=10
TRADEBOT_SMA_LONG=50

# Intervalle des bougies utilisées (ex: 1h, 15m)
TRADEBOT_CANDLE_INTERVAL=1h

# Doit valoir "yes" pour autoriser le mode réel (garde-fou supplémentaire)
TRADEBOT_CONFIRM_LIVE=no
